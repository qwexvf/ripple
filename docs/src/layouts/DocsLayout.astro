---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@/components/Sidebar.astro";
import { buildNav, findAdjacent } from "@/lib/nav";

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  toc?: { depth: number; slug: string; text: string }[];
}

const { title, description, currentSlug, toc = [] } = Astro.props;
const groups = await buildNav();
const { prev, next } = await findAdjacent(currentSlug);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
const editBase = "https://github.com/qwexvf/ripple/edit/main/docs/src/content/docs/";
---

<BaseLayout title={`${title} — ripple`} description={description} currentSlug={currentSlug}>
  <div class="mx-auto max-w-[80rem] px-6">
    <div class="flex gap-8">
      <Sidebar groups={groups} currentSlug={currentSlug} />

      <main class="min-w-0 flex-1 py-10">
        <article class="prose-docs max-w-none">
          <header class="mb-8">
            <h1 class="font-display text-3xl font-bold tracking-tight text-[var(--color-fg-strong)] md:text-4xl">
              {title}
            </h1>
            {description && (
              <p class="mt-3 text-base text-[var(--color-fg-mute)]">{description}</p>
            )}
            <div class="mt-4 h-px w-12 bg-[var(--color-signal)]"></div>
          </header>

          <slot />
        </article>

        <div
          class="mt-12 flex items-center justify-between border-t border-[var(--color-rule)] pt-6 text-sm"
        >
          <a
            href={editBase + currentSlug + ".md"}
            class="font-mono text-xs uppercase tracking-[0.1em] text-[var(--color-fg-faint)] hover:text-[var(--color-signal)]"
          >
            Edit on GitHub →
          </a>
        </div>

        {(prev || next) && (
          <nav
            class="mt-6 grid grid-cols-1 gap-3 border-t border-[var(--color-rule)] pt-6 md:grid-cols-2"
          >
            {prev ? (
              <a
                href={base + prev.href.replace(/^\//, "")}
                class="group block rounded-sm border border-[var(--color-rule)] bg-[var(--color-bg-elev)] p-4 transition-colors hover:border-[var(--color-signal)]"
              >
                <span
                  class="block font-mono text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-fg-faint)]"
                >
                  ← Previous
                </span>
                <span class="mt-1 block font-display font-semibold text-[var(--color-fg-strong)]">
                  {prev.label}
                </span>
              </a>
            ) : (
              <span></span>
            )}
            {next ? (
              <a
                href={base + next.href.replace(/^\//, "")}
                class="group block rounded-sm border border-[var(--color-rule)] bg-[var(--color-bg-elev)] p-4 text-right transition-colors hover:border-[var(--color-signal)]"
              >
                <span
                  class="block font-mono text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-fg-faint)]"
                >
                  Next →
                </span>
                <span class="mt-1 block font-display font-semibold text-[var(--color-fg-strong)]">
                  {next.label}
                </span>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        )}
      </main>

      {toc.length > 0 && (
        <aside class="hidden w-48 shrink-0 lg:block">
          <div class="sticky top-20 py-10">
            <div
              class="mb-2 font-mono text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-fg-faint)]"
            >
              On this page
            </div>
            <ul class="space-y-1 border-l border-[var(--color-rule)]">
              {toc
                .filter((h) => h.depth === 2 || h.depth === 3)
                .map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc-slug={h.slug}
                      class:list={[
                        "toc-link block px-3 py-0.5 text-xs text-[var(--color-fg-mute)] transition-colors hover:text-[var(--color-fg-strong)]",
                        h.depth === 3 ? "pl-6" : "",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </div>

  <script>
    // Scroll-spy: highlight the heading whose top is the last one above
    // an offset line (~96px from the top of the viewport). When scrolled
    // to the very bottom of the page, force the last heading active so
    // the indicator follows all the way down.
    (() => {
      const tocLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".toc-link"),
      );
      if (tocLinks.length === 0) return;

      const headings = tocLinks
        .map((a) => {
          const slug = a.dataset.tocSlug ?? "";
          const el = document.getElementById(slug);
          return el ? { slug, el } : null;
        })
        .filter((x): x is { slug: string; el: HTMLElement } => x !== null);
      if (headings.length === 0) return;

      const setActive = (slug: string) => {
        tocLinks.forEach((a) => {
          if (a.dataset.tocSlug === slug) a.dataset.active = "true";
          else delete a.dataset.active;
        });
      };

      const TOP_OFFSET = 96; // header height + breathing room

      const update = () => {
        const scrollY = window.scrollY;
        const docHeight = document.documentElement.scrollHeight;
        const viewportH = window.innerHeight;

        // Bottom of page → last heading wins regardless of position.
        if (scrollY + viewportH >= docHeight - 8) {
          setActive(headings[headings.length - 1].slug);
          return;
        }

        // Pick the LAST heading whose top is above the offset line.
        let active = headings[0].slug;
        for (const h of headings) {
          const top = h.el.getBoundingClientRect().top;
          if (top - TOP_OFFSET <= 0) active = h.slug;
          else break;
        }
        setActive(active);
      };

      // rAF-throttle scroll handler
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>
</BaseLayout>
